[20.769984, "o", "\u001b[48;2;37;65;49m\u001b[H \u001b[38;2;222;224;225m\u001b[1m$ louro --help\u001b(B\u001b[m\u001b[48;2;37;65;49m\u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[38;2;157;165;169m... (84 earlier lines,\u001b[39m \u001b[38;2;126;136;142mctrl+o\u001b[38;2;157;165;169m to expand)\u001b[39m\u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[38;2;157;165;169m  7  unsupported: the server lacks the feature; do without it\u001b[39m\u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[38;2;157;165;169m  8  the filter failed: tell the operator; don't retry in a loop\u001b[39m\u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[38;2;157;165;169m  11 this louro and the daemon are different versions: follow the hint\u001b[39m         \u001b[49m\u001b[48;2;37;65;49m\u001b[7;1H \u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[38;2;157;165;169mRun `louro <command> --help` for a command's flags.\u001b[39m\u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[38;2;157;165;169mTook 0.0s\u001b[39m\u001b[K\u001b[49m\u001b[48;2;37;65;49m\r\n \u001b[K\u001b[49m\r\n\u001b[K\u001b[38;2;84;137;164m\r\n\u2500\u2500 \u2819\u001b[39m \u001b[38;2;84;137;164mWorking \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
