[20.767751, "o", "\u001b[48;2;33;59;73m\u001b[H \u001b[38;2;222;224;225mlouro is connected to IRC as louro. Run \u001b[38;2;167;152;215mlouro --help\u001b[38;2;222;224;225m, then watch #bots and     \u001b[39m\u001b[49m\u001b[48;2;33;59;73m\u001b[2;1H \u001b[38;2;222;224;225manswer questions people ask you.\u001b[39m\u001b[K\u001b[49m\u001b[48;2;33;59;73m\r\n \u001b[K\u001b[49m\r\n\u001b[K\r\n \u001b[38;2;150;160;164m\u001b[3mThinking...\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[48;2;52;56;58m\r\n \u001b[K\u001b[49m\u001b[48;2;52;56;58m\r\n \u001b[38;2;222;224;225m\u001b[1m$ louro --help\u001b(B\u001b[m\u001b[48;2;52;56;58m\u001b[K\u001b[49m\u001b[48;2;52;56;58m\r\n \u001b[K\u001b[49m\u001b[48;2;52;56;58m\r\n \u001b[38;2;157;165;169mElapsed 0.0s\u001b[39m\u001b[K\u001b[49m\u001b[48;2;52;56;58m\r\n \u001b[K\u001b[49m\r\n\u001b[K\u001b[38;2;84;137;164m\r\n\u2500\u2500 \u2834\u001b[39m \u001b[38;2;84;137;164mWorking \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\u001b[7m\u001b[14;1H \u001b(B\u001b[m\u001b[K\u001b[38;2;84;137;164m\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
